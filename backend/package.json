{
  "name": "backend",
  "version": "1.0.0",
  "description": "ComfyBASE Event Management System Backend",
  "main": "index.js",
    "scripts": {
      "start": "cross-env NODE_OPTIONS='--max-old-space-size=512' node dist/server.js",
      "dev": "cross-env NODE_OPTIONS='--expose-gc --max-old-space-size=512' nodemon --exec ts-node server.ts",
      "build": "tsc",
      "start:pm2": "npm run build && pm2 start dist/server.js --node-args='--max-old-space-size=512' --name comfybase-backend",
      "pm2:logs": "pm2 logs comfybase-backend",
      "pm2:restart": "pm2 restart comfybase-backend",
      "pm2:stop": "pm2 stop comfybase-backend"
    },
  "keywords": [
    "event-management",
    "nodejs",
    "typescript",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/storage": "^7.15.2",
    "@sendgrid/mail": "^8.1.4",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.18.1",
    "firebase-admin": "^11.11.0",
    "helmet": "^7.1.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "passport": "^0.6.0",
    "passport-linkedin-oauth2": "^2.0.0",
    "qrcode": "^1.5.3",
    "stripe": "^14.5.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.10",
    "@types/node": "^20.9.4",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.17",
    "@types/passport-linkedin-oauth2": "^1.5.6",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "pm2": "^6.0.5",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
