# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# JWT
JWT_ACCESS_TOKEN_SECRET=change_me_access_secret
JWT_ACCESS_TOKEN_EXPIRATION=30
JWT_REFRESH_TOKEN_SECRET=change_me_refresh_secret
JWT_REFRESH_TOKEN_EXPIRATION=7
JWT_QR_CODE_SECRET=change_me_qr_secret

# Gmail SMTP (Google App Password — generate at myaccount.google.com/apppasswords)
EMAIL_USER=your_gmail@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Frontend URL
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# Firebase
FIREBASE_CONFIG={"type":"service_account",...}
STORAGE_BUCKET_NAME=gs://your-bucket.appspot.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID_BASIC=price_...
STRIPE_PRICE_ID_PREMIUM=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_CALLBACK_URL=https://yourdomain.com/api/v1/auth/linkedin/callback

# Session
SESSION_SECRET=change_me_session_secret
