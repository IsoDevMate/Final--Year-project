{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "typeRoots": ["./node_modules/@types", "./types"],
     "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
  },
 "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage", "test", "tests", "**/*.spec.ts", "**/*.test.ts"]
}
